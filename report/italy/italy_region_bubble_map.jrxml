				<property name="borderThickness"><![CDATA[Integer.valueOf(1)]]></property>
				<property name="numberPrefix"><![CDATA["EUR "]]></property>
				<property name="numberSuffix"><![CDATA["k"]]></property>
				<property name="legendPosition"><![CDATA["BOTTOM"]]></property>
				<property name="legendItemFontColor"><![CDATA["1D2123"]]></property>
				<property name="legendCaption"><![CDATA["Total revenue (EUR thousands)"]]></property>
				<property name="showMarkerLabels"><![CDATA[Boolean.TRUE]]></property>
				<property name="showMarkerToolTip"><![CDATA[Boolean.TRUE]]></property>
				<property name="autoScaleMarkers"><![CDATA[Boolean.TRUE]]></property>
				<property name="markerBgColor"><![CDATA["2EC0CB"]]></property>
				<property name="markerBorderColor"><![CDATA["FFFFFF"]]></property>
