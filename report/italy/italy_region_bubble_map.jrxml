			<expression><![CDATA[$V{total_revenue}]]></expression>
		</element>
		<element kind="staticText" uuid="17a1b0b0-0001-0002-0003-000000000043" x="580" y="238" width="110" height="12" forecolor="#6C7882" fontSize="8.0">
			<text><![CDATA[Orders]]></text>
