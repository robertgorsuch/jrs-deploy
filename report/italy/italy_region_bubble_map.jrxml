			<text><![CDATA[Highest revenue per 1,000 residents]]></text>
		</element>
		<element kind="textField" uuid="17a1b0b0-0001-0002-0003-000000000046" x="580" y="288" width="222" height="16" forecolor="#000032" fontSize="11.0" evaluationTime="Report" bold="true">
			<expression><![CDATA[$V{top_region} + "  (EUR " + $V{top_rev_per_1k}.toPlainString() + ")"]]></expression>
		</element>
		<element kind="staticText" uuid="17a1b0b0-0001-0002-0003-000000000047" x="580" y="330" width="222" height="60" forecolor="#6C7882" fontSize="8.0">
			<text><![CDATA[Region fill (light to dark blue) is total revenue in EUR thousands; the bubble corrects for population so smaller, wealthier regions stand out. Page 2 ranks all 21 regions with orders, revenue, average order value and the per-capita metric.]]></text>
		</element>
