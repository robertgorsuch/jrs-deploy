					<minValueExpression><![CDATA[100]]></minValueExpression>
					<maxValueExpression><![CDATA[300]]></maxValueExpression>
					<labelExpression><![CDATA["100k - 300k"]]></labelExpression>
				</colorRange>
				<colorRange color="#8AC6F8">
					<minValueExpression><![CDATA[300]]></minValueExpression>
					<maxValueExpression><![CDATA[800]]></maxValueExpression>
					<labelExpression><![CDATA["300k - 800k"]]></labelExpression>
				</colorRange>
				<colorRange color="#3C91FF">
					<minValueExpression><![CDATA[800]]></minValueExpression>
					<maxValueExpression><![CDATA[100000]]></maxValueExpression>
					<labelExpression><![CDATA["800k+"]]></labelExpression>
				</colorRange>
			</component>
		</element>
		<element kind="staticText" uuid="17a1b0b0-0001-0002-0003-000000000030" x="580" y="60" width="222" height="16" forecolor="#000032" fontSize="10.0" bold="true">
			<text><![CDATA[How to read the bubbles]]></text>
		</element>
		<element kind="staticText" uuid="17a1b0b0-0001-0002-0003-000000000031" x="580" y="78" width="222" height="40" forecolor="#1D2123" fontSize="8.0">
			<text><![CDATA[Each teal bubble sits at a region's centroid. Its area is proportional to revenue per 1,000 residents, computed as sum(order amount) / population x 1,000. Labels are region codes.]]></text>
		</element>
		<element kind="ellipse" uuid="17a1b0b0-0001-0002-0003-000000000032" x="586" y="130" width="12" height="12" forecolor="#FFFFFF" backcolor="#2EC0CB"/>
		<element kind="ellipse" uuid="17a1b0b0-0001-0002-0003-000000000033" x="608" y="124" width="24" height="24" forecolor="#FFFFFF" backcolor="#2EC0CB"/>
		<element kind="ellipse" uuid="17a1b0b0-0001-0002-0003-000000000034" x="642" y="112" width="48" height="48" forecolor="#FFFFFF" backcolor="#2EC0CB"/>
		<element kind="staticText" uuid="17a1b0b0-0001-0002-0003-000000000035" x="700" y="128" width="102" height="30" forecolor="#6C7882" fontSize="8.0">
			<text><![CDATA[small -> large:
lowest -> highest
revenue per 1,000 residents]]></text>
		</element>
		<element kind="staticText" uuid="17a1b0b0-0001-0002-0003-000000000040" x="580" y="180" width="222" height="16" forecolor="#000032" fontSize="10.0" bold="true">
			<text><![CDATA[Year to date 2026]]></text>
		</element>
		<element kind="staticText" uuid="17a1b0b0-0001-0002-0003-000000000041" x="580" y="200" width="110" height="12" forecolor="#6C7882" fontSize="8.0">
