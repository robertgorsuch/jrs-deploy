<!-- Created with Jaspersoft Studio version 10.0.0.final using JasperReports Library version 7.0.5-4355b62c664a7760655b513bdd58950cb3365f54  -->
<jasperReport name="italy_region_bubble_map" language="java" pageWidth="842" pageHeight="595" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="17a1b0b0-0001-0002-0003-000000000001" titleNewPage="true">
	<dataset name="bubbles" uuid="17a1b0b0-0001-0002-0003-000000000002">
		<query language="sql"><![CDATA[SELECT r.region_id, r.region, r.short_code, r.population, r.map_x, r.map_y, o.orders, o.revenue, round(o.revenue / r.population * 1000, 0) AS rev_per_1k, round(4 + 15 * sqrt((o.revenue / r.population) / max(o.revenue / r.population) OVER ()), 1) AS radius FROM demo_italy_regions r JOIN (SELECT region_id, count(*) AS orders, sum(amount) AS revenue FROM demo_italy_orders GROUP BY region_id) o ON o.region_id = r.region_id ORDER BY rev_per_1k DESC]]></query>
		<field name="region_id" class="java.lang.String"/>
		<field name="region" class="java.lang.String"/>
		<field name="short_code" class="java.lang.String"/>
		<field name="population" class="java.lang.Integer"/>
		<field name="map_x" class="java.math.BigDecimal"/>
		<field name="map_y" class="java.math.BigDecimal"/>
		<field name="orders" class="java.lang.Long"/>
		<field name="revenue" class="java.math.BigDecimal"/>
		<field name="rev_per_1k" class="java.math.BigDecimal"/>
		<field name="radius" class="java.math.BigDecimal"/>
	</dataset>
	<query language="sql"><![CDATA[SELECT r.region_id, r.region, r.short_code, r.population, o.orders, o.revenue, round(o.revenue / 1000, 1) AS revenue_k, round(o.revenue / r.population * 1000, 0) AS rev_per_1k, round(o.revenue / o.orders, 2) AS avg_order FROM demo_italy_regions r JOIN (SELECT region_id, count(*) AS orders, sum(amount) AS revenue FROM demo_italy_orders GROUP BY region_id) o ON o.region_id = r.region_id ORDER BY rev_per_1k DESC]]></query>
	<field name="region_id" class="java.lang.String"/>
	<field name="region" class="java.lang.String"/>
	<field name="short_code" class="java.lang.String"/>
	<field name="population" class="java.lang.Integer"/>
	<field name="orders" class="java.lang.Long"/>
	<field name="revenue" class="java.math.BigDecimal"/>
	<field name="revenue_k" class="java.math.BigDecimal"/>
	<field name="rev_per_1k" class="java.math.BigDecimal"/>
	<field name="avg_order" class="java.math.BigDecimal"/>
	<variable name="total_revenue" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{revenue}]]></expression>
	</variable>
	<variable name="total_orders" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{orders}]]></expression>
	</variable>
	<variable name="top_region" calculation="First" class="java.lang.String">
		<expression><![CDATA[$F{region}]]></expression>
	</variable>
	<variable name="top_rev_per_1k" calculation="First" class="java.math.BigDecimal">
		<expression><![CDATA[$F{rev_per_1k}]]></expression>
	</variable>
	<title height="555">
		<element kind="staticText" uuid="17a1b0b0-0001-0002-0003-000000000011" x="0" y="-2" width="802" height="26" forecolor="#000032" fontSize="16.0" bold="true" hTextAlign="Center">
			<text><![CDATA[Italy Regional Sales: Revenue per 1,000 Residents]]></text>
		</element>
		<element kind="staticText" uuid="17a1b0b0-0001-0002-0003-000000000012" x="0" y="26" width="802" height="14" forecolor="#6C7882" fontSize="9.0" hTextAlign="Center">
			<text><![CDATA[Bubble area scales with revenue per 1,000 residents (EUR, year to date 2026). Region fill shows total revenue. Demo orders data.]]></text>
		</element>
		<element kind="component" uuid="17a1b0b0-0001-0002-0003-000000000020" x="0" y="44" width="560" height="500">
			<component kind="fusionmap" evaluationTime="Report">
				<mapNameExpression><![CDATA["Italy"]]></mapNameExpression>
				<dataset>
					<entity>
						<idExpression><![CDATA[$F{region_id}]]></idExpression>
						<valueExpression><![CDATA[$F{revenue_k}]]></valueExpression>
					</entity>
				</dataset>
				<markerData>
					<dataset>
						<datasetRun uuid="17a1b0b0-0001-0002-0003-000000000022" subDataset="bubbles">
							<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
						</datasetRun>
					</dataset>
					<item>
						<property name="id"><![CDATA["m" + $F{region_id}]]></property>
						<property name="x"><![CDATA[$F{map_x}.toPlainString()]]></property>
						<property name="y"><![CDATA[$F{map_y}.toPlainString()]]></property>
						<property name="shapeId"><![CDATA["s" + $F{region_id}]]></property>
						<property name="label"><![CDATA[$F{short_code}]]></property>
						<property name="labelPos" value="center"/>
						<property name="radius"><![CDATA[$F{radius}.toPlainString()]]></property>
						<property name="toolText"><![CDATA[$F{region} + ": EUR " + $F{rev_per_1k}.toPlainString() + " per 1,000 residents, " + $F{orders} + " orders, EUR " + $F{revenue}.setScale(0, java.math.RoundingMode.HALF_UP).toPlainString() + " revenue"]]></property>
					</item>
				</markerData>
				<shapeData>
					<dataset>
						<datasetRun uuid="17a1b0b0-0001-0002-0003-000000000021" subDataset="bubbles">
							<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
						</datasetRun>
					</dataset>
					<item>
						<property name="id"><![CDATA["s" + $F{region_id}]]></property>
						<property name="type" value="circle"/>
						<property name="radius"><![CDATA[$F{radius}.toPlainString()]]></property>
						<property name="fillColor" value="2EC0CB"/>
						<property name="fillAlpha" value="80"/>
						<property name="borderColor" value="FFFFFF"/>
						<property name="borderThickness" value="1"/>
					</item>
				</shapeData>
				<property name="includeNameInLabels"><![CDATA[Boolean.FALSE]]></property>
				<property name="showLabels"><![CDATA[Boolean.FALSE]]></property>
				<property name="showCanvasBorder"><![CDATA[Boolean.FALSE]]></property>
