<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by jasper-deploy scaffold_jrxml.py. JR7-native (JasperReports 7.0.6). -->
<jasperReport name="simple_sales_by_state" language="java" pageWidth="842" pageHeight="595" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<query language="SQL"><![CDATA[
SELECT
  s.store_state,
  COUNT(DISTINCT s.store_id)::int AS store_count,
  CAST(SUM(sf.unit_sales) AS DECIMAL(18,2)) AS unit_sales,
  CAST(SUM(sf.store_sales) AS DECIMAL(18,2)) AS total_sales,
  CAST(SUM(sf.store_sales - sf.store_cost) AS DECIMAL(18,2)) AS gross_profit
FROM sales_fact_1998 sf
JOIN store s ON sf.store_id = s.store_id
WHERE s.store_state IS NOT NULL
GROUP BY s.store_state
ORDER BY total_sales DESC
	]]></query>

	<field name="store_state" class="java.lang.String"/>
	<field name="store_count" class="java.lang.Integer"/>
	<field name="unit_sales" class="java.math.BigDecimal"/>
	<field name="total_sales" class="java.math.BigDecimal"/>
	<field name="gross_profit" class="java.math.BigDecimal"/>

